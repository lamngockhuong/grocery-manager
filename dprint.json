{
  "includes": ["src/**/*.gs", "src/**/*.html", "**/*.md"],
  "excludes": ["node_modules", "**/node_modules", "src/index.html"],
  "typescript": {
    "indentWidth": 2,
    "lineWidth": 120,
    "quoteStyle": "preferSingle",
    "trailingCommas": "never",
    "semiColons": "always"
  },
  "markup": {
    "indentWidth": 2
  },
  "markdown": {
    "lineWidth": 120,
    "textWrap": "maintain"
  },
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.15.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.26.0.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm"
  ]
}
